# API URL (로컬 개발)
NEXT_PUBLIC_API_URL=http://localhost:8081/api

# 서버 렌더링·SEO API 요청 제한시간 (밀리초, 최대 300000)
SEO_API_TIMEOUT_MS=8000

# WebSocket URL (로컬: ws://, 프로덕션: wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:8081/api/ws/chat

# 환경
NODE_ENV=development

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
