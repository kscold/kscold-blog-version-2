FROM gradle:9.8.2-jdk25@sha256:b4142d83c87243b2dfd9a2d60a9412b83960663adbecb6995371889cf22b25c3 AS builder

WORKDIR /app

# 의존성 정의를 먼저 복사해 애플리케이션 소스 변경 시에도 다운로드 계층을 재사용합니다.
COPY apps/api/build.gradle apps/api/settings.gradle ./
COPY apps/api/gradlew ./gradlew
COPY apps/api/gradle ./gradle
RUN ./gradlew dependencies --configuration runtimeClasspath --no-daemon --quiet >/dev/null

COPY apps/api/src ./src
RUN ./gradlew bootJar --no-daemon

FROM ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c AS runner

ARG TARGETARCH

ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    LANG=C.UTF-8

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl wget tzdata \
    && case "${TARGETARCH}" in \
         amd64) JRE_ARCH=x64; JRE_SHA256=6fac98f0c8202efc3135a9e9e42aa61963ec42d1c5cbb40caf231e7b14a24ef6 ;; \
         arm64) JRE_ARCH=aarch64; JRE_SHA256=963931723891302ebb2687178532c3d793d71e2577cd058061c7efb396140a86 ;; \
         *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --retry 3 \
       "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jre_${JRE_ARCH}_linux_hotspot_25.0.5_8.tar.gz" \
       --output /tmp/jre.tar.gz \
    && echo "${JRE_SHA256}  /tmp/jre.tar.gz" | sha256sum --check - \
    && mkdir -p "${JAVA_HOME}" \
    && tar --extract --gzip --file /tmp/jre.tar.gz --directory "${JAVA_HOME}" --strip-components=1 \
    && rm -rf /tmp/jre.tar.gz /var/lib/apt/lists/* \
    && groupadd --gid 10001 blog-api \
    && useradd --uid 10001 --gid blog-api --no-create-home --shell /usr/sbin/nologin blog-api \
    && mkdir -p /app/uploads \
    && chown -R blog-api:blog-api /app

COPY --from=builder --chown=blog-api:blog-api /app/build/libs/blog-api-*.jar ./app.jar

USER blog-api

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget --quiet --timeout=3 --output-document=/dev/null http://127.0.0.1:8080/api/health || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
